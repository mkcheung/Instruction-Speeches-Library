# §21.5: without this, node_modules/, vendor/, .git/ and every test video are
# sent to the daemon as build context on every build — turning a two-second
# rebuild into a minute. Highest value-to-effort file in the whole setup.

.git/
legacy/

api/vendor/
api/node_modules/
api/.env
api/storage/logs/*
api/storage/framework/cache/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/bootstrap/cache/*.php

web/node_modules/
web/dist/
web/.env

**/*.log
.DS_Store
