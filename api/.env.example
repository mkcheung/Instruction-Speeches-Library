APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.speechcoach.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches compose.yaml's postgres service defaults
# (${DB_DATABASE:-speechcoach} etc.) — keep the two in sync.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=speechcoach
DB_USERNAME=speechcoach
DB_PASSWORD=speechcoach

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# STEP-02-first-deploy.md: the leading dot is the whole point — it's what
# makes the cookie valid on BOTH app. and api. subdomains rather than only
# the exact host that set it.
SESSION_DOMAIN=.speechcoach.test
# The production setting (STEP-02): a Secure cookie is not stored over
# plain HTTP, so this requires the mkcert TLS layout to actually work.
SESSION_SECURE_COOKIE=true
# Pinned explicitly: Laravel 13 changed the generated default cookie name
# format (app_name_session -> app-name-session), so leaving this unset means
# a future framework upgrade silently logs out every user by changing the
# cookie Laravel looks for (MODERNIZATION_PLAN.md §5.9 trap #3,
# STEP-01-identity.md acceptance list).
SESSION_COOKIE=speechcoach_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# §9.2: the transcode queue, consumed by the `queue-worker` compose service.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# `predis` (pure PHP) rather than `phpredis` — no PECL extension to compile
# into the Alpine image for a self-hosted-Redis dev setup this small (§9.2).
# `valkey` is the compose service name (Redis-protocol-compatible, §21.4).
REDIS_CLIENT=predis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379
# `redis-long` (config/queue.php) reuses the REDIS_* vars above and only
# overrides retry_after, for TranscodeSpeechAsset (§9.2) — long enough that
# the queue doesn't release a second worker onto a still-running transcode.
# Config already defaults to 3900 if unset; only override to change it.
# REDIS_QUEUE_LONG_RETRY_AFTER=3900
# The `ffmpeg-worker` compose service passes `redis-long` as queue:work's
# connection arg and `--queue=transcode` explicitly, so REDIS_QUEUE (used by
# both `redis` and `redis-long` connections, config/queue.php) does not need
# to be `transcode` for the default queue-worker to keep working — only
# uncomment/change this if you need TranscodeSpeechAsset dispatched to a
# queue name other than `transcode`.
# REDIS_QUEUE=default

# §5.6's config seam for FFmpeg's video encoder: `libx264` today (CPU,
# software H.264 — Docker Desktop on macOS can't pass through VideoToolbox,
# §5.6/§21.3), swap to e.g. `h264_nvenc` later for hardware encoding without
# a code change. NOT YET WIRED as of STEP-04's Docker/Compose slice —
# api/app/Services/Transcoding/FfmpegTranscoder.php is still STEP-03's
# remux-only (`-c copy`) implementation, so nothing reads this env var yet.
# Documented here ahead of the transcoder work that will consume it.
TRANSCODE_VIDEO_CODEC=libx264

# Mailpit (S1's "container that exists purely to intercept something" —
# STEP-01-identity.md) — MAIL_HOST=mailpit just works over the compose
# network, no further config. Web UI at http://localhost:8025.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SeaweedFS S3-compatible endpoint (media disk — config/filesystems.php,
# App\Services\MediaUrlSigner). Credentials below match the identity in
# docker/seaweedfs/s3.json (-s3.config) — keep the two in sync. Point
# AWS_ENDPOINT at the seaweedfs service's S3 port inside the docker network.
AWS_ACCESS_KEY_ID=speechcoach-dev-key
AWS_SECRET_ACCESS_KEY=speechcoach-dev-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=media
AWS_ENDPOINT=http://seaweedfs:8333
# Browser-facing address for the same SeaweedFS S3 gateway — presigned URLs
# must be SIGNED against a host a browser can actually resolve and connect
# to, which is not `seaweedfs` (only resolvable inside the compose network).
# See MediaUrlSigner / filesystems.php's `media_public` disk.
AWS_ENDPOINT_PUBLIC=http://localhost:8333
AWS_URL=
# SeaweedFS's S3 gateway does not do virtual-hosted-style buckets
# (bucket.host/key) the way AWS S3 does, so path-style
# (host/bucket/key) is what MediaUrlSigner needs — see S0's spike
# writeup for the "proven necessary or not, in writing" acceptance item.
AWS_USE_PATH_STYLE_ENDPOINT=true

# STEP-02-first-deploy.md: SPA origin is a DIFFERENT subdomain from the API
# (app. vs api.), sharing only the registrable domain speechcoach.test — the
# whole point of the exercise (§5.2). Must be an explicit origin, not '*',
# because CORS credentials mode (config/cors.php supports_credentials=true)
# forbids the wildcard. Comma-separate additional origins if ever needed.
FRONTEND_URL=https://app.speechcoach.test
CORS_ALLOWED_ORIGINS=https://app.speechcoach.test

# config/sanctum.php's default stateful-domain formula (localhost,
# localhost:3000, 127.0.0.1, 127.0.0.1:8000, ::1, plus APP_URL's host) never
# includes the actual host a browser uses. Without an exact match here,
# EnsureFrontendRequestsAreStateful silently refuses to treat the request as
# "from the frontend" at all — no session cookie is honored, no CSRF cookie
# is issued — a 401 with no obvious cause, only found by actually curling an
# authenticated endpoint through nginx. Only the SPA's own host belongs
# here — NOT api.speechcoach.test itself.
SANCTUM_STATEFUL_DOMAINS=app.speechcoach.test

VITE_APP_NAME="${APP_NAME}"
