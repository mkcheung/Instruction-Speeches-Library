APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches compose.yaml's postgres service defaults
# (${DB_DATABASE:-speechcoach} etc.) — keep the two in sync.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=speechcoach
DB_USERNAME=speechcoach
DB_PASSWORD=speechcoach

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Pinned explicitly: Laravel 13 changed the generated default cookie name
# format (app_name_session -> app-name-session), so leaving this unset means
# a future framework upgrade silently logs out every user by changing the
# cookie Laravel looks for (MODERNIZATION_PLAN.md §5.9 trap #3,
# STEP-01-identity.md acceptance list).
SESSION_COOKIE=speechcoach_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (S1's "container that exists purely to intercept something" —
# STEP-01-identity.md) — MAIL_HOST=mailpit just works over the compose
# network, no further config. Web UI at http://localhost:8025.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SeaweedFS S3-compatible endpoint (media disk — config/filesystems.php,
# App\Services\MediaUrlSigner). Credentials below match the identity in
# docker/seaweedfs/s3.json (-s3.config) — keep the two in sync. Point
# AWS_ENDPOINT at the seaweedfs service's S3 port inside the docker network.
AWS_ACCESS_KEY_ID=speechcoach-dev-key
AWS_SECRET_ACCESS_KEY=speechcoach-dev-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=media
AWS_ENDPOINT=http://seaweedfs:8333
# Browser-facing address for the same SeaweedFS S3 gateway — presigned URLs
# must be SIGNED against a host a browser can actually resolve and connect
# to, which is not `seaweedfs` (only resolvable inside the compose network).
# See MediaUrlSigner / filesystems.php's `media_public` disk.
AWS_ENDPOINT_PUBLIC=http://localhost:8333
AWS_URL=
# SeaweedFS's S3 gateway does not do virtual-hosted-style buckets
# (bucket.host/key) the way AWS S3 does, so path-style
# (host/bucket/key) is what MediaUrlSigner needs — see S0's spike
# writeup for the "proven necessary or not, in writing" acceptance item.
AWS_USE_PATH_STYLE_ENDPOINT=true

# Dev SPA origin — must be an explicit origin, not '*', because CORS
# credentials mode (config/cors.php supports_credentials=true) forbids the
# wildcard. Comma-separate additional origins if ever needed.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# config/sanctum.php's default stateful-domain formula (localhost,
# localhost:3000, 127.0.0.1, 127.0.0.1:8000, ::1, plus APP_URL's host) never
# includes the actual host:port a browser uses in either real topology this
# project runs: the Vite dev server (localhost:5173) or the containerized
# single-origin nginx build (localhost:8080, compose.yaml's `web` service).
# Without an exact match here, EnsureFrontendRequestsAreStateful silently
# refuses to treat the request as "from the frontend" at all — no session
# cookie is honored, no CSRF cookie is issued — a 401 with no obvious cause,
# only found by actually curling an authenticated endpoint through nginx.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080,127.0.0.1:5173,127.0.0.1:8080

VITE_APP_NAME="${APP_NAME}"
