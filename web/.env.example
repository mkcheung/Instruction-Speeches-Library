# The `app` (php-fpm) container has no published port of its own — it can't
# speak HTTP directly. `web` (nginx) is the single HTTP entrypoint, proxying
# /api to app:9000 over fastcgi, published at 8080 (8000 was already taken by
# another project on this host — see compose.yaml). Point the host-run Vite
# dev server at it here.
VITE_API_URL=http://localhost:8080
VITE_ENABLE_SPIKES=true

# STEP-14-deploy-hardening.md: GlitchTip's SPA DSN (a self-hosted,
# zero-cost Sentry-wire-protocol-compatible error tracker — see
# api/.env.example's GLITCHTIP_* for the server side). Left blank here on
# purpose: `lib/sentry.ts` no-ops when this is unset, so local dev never
# reports anywhere unless you've stood up GlitchTip and pasted its DSN in.
VITE_GLITCHTIP_DSN=
